<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_woo_pull_orders" model="ir.cron">
        <field name="name">WooCommerce: pull orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_woo_pull_orders()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">False</field>
    </record>
    <record id="cron_woo_pull_products" model="ir.cron">
        <field name="name">WooCommerce: pull products</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">model._cron_woo_pull_products()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">False</field>
    </record>
    <record id="cron_woo_push_stock" model="ir.cron">
        <field name="name">WooCommerce: push stock</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">model._cron_woo_push_stock()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">False</field>
    </record>
</odoo>
