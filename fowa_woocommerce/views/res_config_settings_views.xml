<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_fowa_woo" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.fowa.woo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="WooCommerce" string="WooCommerce" name="fowa_woocommerce" groups="base.group_system">
                    <block title="Connection" name="fowa_woo_connection">
                        <setting string="Store" help="WooCommerce > Settings > Advanced > REST API (Read/Write keys)">
                            <div class="content-group">
                                <div class="row mt8"><label class="col-lg-3" for="fowa_woo_url"/><field name="fowa_woo_url"/></div>
                                <div class="row"><label class="col-lg-3" for="fowa_woo_consumer_key"/><field name="fowa_woo_consumer_key" password="True"/></div>
                                <div class="row"><label class="col-lg-3" for="fowa_woo_consumer_secret"/><field name="fowa_woo_consumer_secret" password="True"/></div>
                                <div class="row"><label class="col-lg-3" for="fowa_woo_webhook_secret"/><field name="fowa_woo_webhook_secret" password="True"/></div>
                                <button name="action_fowa_woo_test" type="object" string="Test connection" class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Sync" name="fowa_woo_sync">
                        <setting string="Orders" help="Auto-confirm orders once WooCommerce marks them Processing/Completed">
                            <field name="fowa_woo_auto_confirm"/>
                            <button name="action_fowa_woo_sync_orders" type="object" string="Sync orders now" class="btn-link"/>
                        </setting>
                        <setting string="Products &amp; Stock" help="Warehouse used for the stock quantity shown on the website">
                            <field name="fowa_woo_warehouse_id"/>
                            <button name="action_fowa_woo_sync_products" type="object" string="Import products now" class="btn-link"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
