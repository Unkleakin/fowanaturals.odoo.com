<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_fowa_woo" model="ir.ui.view">
        <field name="name">sale.order.form.fowa.woo</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="client_order_ref" position="after">
                <field name="woo_id" readonly="1" invisible="not woo_id"/>
                <field name="woo_status" readonly="1" invisible="not woo_id"/>
            </field>
        </field>
    </record>
    <record id="product_template_form_fowa_woo" model="ir.ui.view">
        <field name="name">product.template.form.fowa.woo</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="woo_id" readonly="1"/>
                <field name="woo_publish_stock"/>
            </field>
        </field>
    </record>
</odoo>
